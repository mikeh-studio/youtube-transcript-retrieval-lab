{
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "notes"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "start_line", "end_line"],
        "properties": {
          "title": { "type": "string" },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
