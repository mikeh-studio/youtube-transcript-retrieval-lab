{
  "type": "object",
  "additionalProperties": false,
  "required": ["cases", "notes"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "required_facts", "gold_spans"],
        "properties": {
          "question": { "type": "string" },
          "required_facts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string" }
          },
          "gold_spans": {
            "type": "array",
            "minItems": 2,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "start_line", "end_line"],
              "properties": {
                "source_id": { "type": "string" },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
