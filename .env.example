OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SAKANA_API_KEY=your_sakana_api_key_here
YOUTUBE_API_KEY=

# Optional Evaluation Dataset Generator overrides. Codex CLI authentication is
# handled by `codex login`; provider API keys are not forwarded to the CLI job.
YT_RAG_CODEX_BIN=
YT_RAG_CODEX_MODEL=

# Optional provider defaults.
SAKANA_MODEL=fugu
SAKANA_BASE_URL=https://api.sakana.ai/v1

# Optional read-only connection to private local catalog schema 0008.
# CONTENT_LIBRARY_CATALOG_URL=http://127.0.0.1:8100
